<!-- pages/tenant/profile/profile.wxml -->
<view class="profile-page">
  <!-- 用户信息头部 -->
  <view class="user-header">
    <view class="avatar-wrap" bindtap="chooseAvatar">
      <image class="avatar" src="{{userInfo.avatar || '/assets/images/default-avatar.png'}}" mode="aspectFill"></image>
      <view class="avatar-edit">换</view>
    </view>
    <view class="user-meta">
      <text class="nickname">{{userInfo.nickname || '未设置昵称'}}</text>
      <text class="user-id">ID: {{userInfo.userId || '-'}}</text>
      <text class="phone">{{userInfo.phone || '未绑定手机号'}}</text>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="info-section">
    <view class="section-title">基本信息</view>
    <view class="info-row" bindtap="editNickname">
      <text class="il">昵称</text>
      <view class="ir">
        <text class="iv">{{userInfo.nickname || '未设置'}}</text>
        <text class="edit-arrow">›</text>
      </view>
    </view>
    <view class="info-row">
      <text class="il">手机号</text>
      <text class="iv">{{userInfo.phone}}</text>
    </view>
    <view class="info-row">
      <text class="il">用户ID</text>
      <text class="iv">{{userInfo.userId}}</text>
    </view>
  </view>

  <!-- 快捷功能 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="goOrders">
      <text class="menu-icon">📋</text>
      <text class="menu-label">我的订单</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goFavorites">
      <text class="menu-icon">❤️</text>
      <text class="menu-label">我的收藏</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goMessages">
      <text class="menu-icon">💬</text>
      <text class="menu-label">我的消息</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 更多功能 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="goFeedback">
      <text class="menu-icon">📢</text>
      <text class="menu-label">反馈投诉</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="logout">
      <text class="menu-icon">🚪</text>
      <text class="menu-label logout-label">退出登录</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="version-info">
    <text>随心住 v1.0.0</text>
  </view>
</view>
