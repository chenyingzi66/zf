/* pages/tenant/booking/booking.wxss */
.booking-page { min-height: 100vh; background: #F5F5F5; padding-bottom: 160rpx; }

.house-summary { display: flex; align-items: center; background: #fff; padding: 24rpx; margin-bottom: 20rpx; gap: 20rpx; }
.house-thumb { width: 160rpx; height: 120rpx; border-radius: 12rpx; flex-shrink: 0; background: #f5f5f5; }
.house-summary-info { flex: 1; }
.house-title { font-size: 30rpx; font-weight: 500; color: #333; line-height: 1.4; }
.house-location { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.house-price-row { display: flex; align-items: baseline; margin-top: 12rpx; }
.price-num { font-size: 36rpx; font-weight: bold; color: #FF4444; }
.price-unit { font-size: 24rpx; color: #999; }
.rent-type-tag { display: inline-block; font-size: 22rpx; color: #4A90E2; background: #E8F4FF; padding: 4rpx 12rpx; border-radius: 4rpx; margin-top: 8rpx; }

.form-card, .fee-card, .tips-card { background: #fff; margin-bottom: 20rpx; padding: 30rpx; border-radius: 12rpx; }
.card-title { font-size: 30rpx; font-weight: bold; color: #333; padding-left: 12rpx; border-left: 6rpx solid #4A90E2; margin-bottom: 24rpx; }
.form-item { padding: 20rpx 0; border-bottom: 1rpx solid #F5F5F5; }
.form-item:last-child { border-bottom: none; }
.form-label { font-size: 28rpx; color: #666; display: block; margin-bottom: 12rpx; }
.form-label.required::before { content: '* '; color: #FF4444; }
.form-input { width: 100%; height: 80rpx; line-height: 80rpx; font-size: 28rpx; color: #333; background: #f9f9f9; border-radius: 8rpx; padding: 0 16rpx; box-sizing: border-box; }
.picker-val { display: flex; justify-content: space-between; align-items: center; height: 80rpx; background: #f9f9f9; border-radius: 8rpx; padding: 0 16rpx; }
.error-border { border-bottom: 2rpx solid #ff4d4f !important; }
.remark-input { width: 100%; min-height: 120rpx; font-size: 28rpx; color: #333; line-height: 1.6; background: #f9f9f9; border-radius: 8rpx; padding: 16rpx; box-sizing: border-box; }

.fee-card { background: linear-gradient(135deg, #fff 0%, #f8fbff 100%); }
.fee-row { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.fee-row:last-child { border-bottom: none; }
.highlight-row { background: #f0f7ff; margin: 0 -20rpx; padding: 16rpx 20rpx; border-radius: 8rpx; border-bottom: none; margin-bottom: 8rpx; }
.formula-row { background: #fafafa; margin: 0 -20rpx; padding: 16rpx 20rpx; border-radius: 8rpx; }
.total-row { margin-top: 12rpx; padding-top: 20rpx; border-top: 2rpx solid #eee; border-bottom: none; }
.fee-label { font-size: 28rpx; color: #666; }
.fee-val-wrap { display: flex; align-items: center; }
.fee-val { font-size: 28rpx; color: #333; }
.fee-sub { font-size: 24rpx; color: #999; margin-left: 8rpx; }
.fee-total { font-size: 40rpx; font-weight: bold; }
.bold { font-weight: bold; color: #333; }
.rent-type { color: #4A90E2; font-weight: 500; }
.formula { color: #666; font-size: 26rpx; }

.red { color: #FF4444; }
.orange { color: #FA8C16; }
.gray { color: #999; }
.gray-sm { color: #999; font-size: 24rpx; }
.black { color: #333; }
.arrow { color: #999; font-size: 32rpx; }

.tips-title { font-size: 28rpx; font-weight: bold; color: #333; display: block; margin-bottom: 16rpx; }
.tips-text { font-size: 24rpx; color: #999; display: block; line-height: 2; }

.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; background: #fff; display: flex; align-items: center; padding: 20rpx 30rpx; box-shadow: 0 -4rpx 12rpx rgba(0,0,0,0.08); }
.total-info { flex: 1; display: flex; flex-direction: column; }
.total-num { font-size: 40rpx; font-weight: bold; color: #FF4444; }
.submit-btn { flex: 1; height: 88rpx; line-height: 88rpx; text-align: center; background: linear-gradient(135deg, #4A90E2, #357ABD); color: #fff; border-radius: 44rpx; font-size: 30rpx; font-weight: 500; }
.submit-btn.disabled { background: #ccc; color: #999; }

.safe-area-bottom { padding-bottom: env(safe-area-inset-bottom); }
