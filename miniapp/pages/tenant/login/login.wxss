/* pages/tenant/login/login.wxss */

.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 20rpx;
  display: flex;
  flex-direction: column;
}



.login-form {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.1);
}

.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #f9f9f9;
}

.form-input:focus {
  border-color: #667eea;
  background: #fff;
}

.agreement {
  margin: 30rpx 0;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 8rpx;
}

.agreement-item {
  display: flex;
  align-items: flex-start;
  font-size: 26rpx;
  color: #666;
}

.agreement-item checkbox {
  margin-right: 12rpx;
  margin-top: 4rpx;
}

.agreement-text {
  color: #666;
}

.agreement-link {
  color: #667eea;
  text-decoration: underline;
  margin: 0 4rpx;
}

.agreement-links {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.agreement-separator {
  color: #999;
  margin: 0 12rpx;
}

.btn-login {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
  border-radius: 8rpx;
  font-size: 32rpx;
  font-weight: bold;
  margin-top: 20rpx;
  transition: all 0.3s ease;
}

.btn-login:active:not([disabled]) {
  transform: scale(0.98);
  opacity: 0.9;
}

.btn-login[disabled] {
  opacity: 0.6;
}

.btn-login.loading {
  opacity: 0.7;
}

.divider {
  display: flex;
  align-items: center;
  margin: 30rpx 0;
  gap: 12rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #ddd;
}

.divider-text {
  color: #999;
  font-size: 26rpx;
}

.register-link {
  text-align: center;
  margin-top: 30rpx;
  font-size: 26rpx;
  color: #666;
}

.register-link .link {
  color: #667eea;
  text-decoration: underline;
  margin-left: 8rpx;
}

.footer-tips {
  margin-top: 40rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 8rpx;
  color: #fff;
}

.tips-item {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  margin-bottom: 8rpx;
}
