/* pages/tenant/house-list/house-list.wxss */
.list-page { min-height: 100vh; background: #F5F5F5; }

/* 搜索栏 */
.search-bar { display: flex; align-items: center; background: #fff; padding: 16rpx 20rpx; gap: 16rpx; }
.search-input-wrap { flex: 1; background: #F5F5F5; border-radius: 32rpx; padding: 0 24rpx; height: 68rpx; display: flex; align-items: center; }
.search-input { flex: 1; font-size: 28rpx; }
.clear-btn { font-size: 26rpx; color: #999; white-space: nowrap; }

/* 筛选栏 */
.filter-bar { display: flex; background: #fff; border-bottom: 1rpx solid #eee; position: sticky; top: 0; z-index: 100; }
.filter-tab { flex: 1; display: flex; align-items: center; justify-content: center; height: 88rpx; font-size: 28rpx; color: #333; gap: 6rpx; }
.filter-tab.active { color: #4A90E2; }
.arrow { font-size: 20rpx; }

/* 遮罩 */
.mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.4); z-index: 90; }

/* 筛选面板 */
.filter-panel { position: absolute; top: 176rpx; left: 0; right: 0; background: #fff; z-index: 100; box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.1); }
.option-item { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 32rpx; font-size: 28rpx; color: #333; border-bottom: 1rpx solid #F5F5F5; }
.option-item.selected { color: #4A90E2; background: #F0F7FF; }
.check { color: #4A90E2; font-size: 28rpx; }

/* 房源列表 */
.house-list { padding: 20rpx; }
.house-card { display: flex; background: #fff; border-radius: 16rpx; margin-bottom: 20rpx; overflow: hidden; }
.house-cover { width: 220rpx; height: 180rpx; flex-shrink: 0; }
.house-body { flex: 1; padding: 20rpx; display: flex; flex-direction: column; justify-content: space-between; }
.house-name { font-size: 28rpx; font-weight: 500; color: #333; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.house-meta { font-size: 24rpx; color: #999; }
.sep { margin: 0 8rpx; }
.house-loc { font-size: 22rpx; color: #aaa; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.house-foot { display: flex; justify-content: space-between; align-items: center; }
.house-price { display: flex; align-items: baseline; }
.p-num { font-size: 36rpx; font-weight: bold; color: #FF4444; }
.p-unit { font-size: 22rpx; color: #999; margin-left: 4rpx; }
.house-tag { font-size: 22rpx; color: #4A90E2; background: #F0F7FF; padding: 4rpx 12rpx; border-radius: 6rpx; }

/* 空/加载 */
.empty-state { display: flex; flex-direction: column; align-items: center; padding: 100rpx 40rpx; }
.empty-icon { font-size: 100rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 28rpx; color: #999; }
.empty-tip { font-size: 24rpx; color: #ccc; margin-top: 12rpx; }
.load-more { text-align: center; padding: 40rpx; font-size: 26rpx; color: #999; }
