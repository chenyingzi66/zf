<!-- pages/tenant/house-detail/house-detail.wxml -->
<view class="detail-container" wx:if="{{house}}">
  <!-- 图片轮播 -->
  <swiper class="image-swiper" indicator-dots circular>
    <swiper-item wx:for="{{picsArr}}" wx:key="index" bindtap="previewImages" data-index="{{index}}">
      <image class="house-img" src="{{item}}" mode="aspectFill"></image>
    </swiper-item>
  </swiper>

  <!-- 基础信息 -->
  <view class="info-card">
    <view class="price-row">
      <view class="price-wrap">
        <text class="price">{{house.price}}</text>
        <text class="unit">元/{{house.rentType === 'monthly' ? '月' : house.rentType}}</text>
      </view>
      <view class="favorite-btn {{isFavorite ? 'active' : ''}}" bindtap="toggleFavorite">
        <text class="fav-icon">{{isFavorite ? '❤️' : '🤍'}}</text>
        <text>{{isFavorite ? '已收藏' : '收藏'}}</text>
      </view>
    </view>
    <view class="title">{{house.title}}</view>
    <view class="house-id">房源编号: {{house.houseId}}</view>
    <view class="tags">
      <text class="tag">{{house.houseType}}</text>
      <text class="tag">{{house.area}}㎡</text>
      <text class="tag">{{house.floor}}</text>
      <text class="tag">{{house.orientation}}</text>
    </view>
    <view class="address-row">
      <text>📍</text>
      <text class="address">{{house.province}} {{house.city}} {{house.district}} · {{house.address}}</text>
    </view>
  </view>

  <!-- 房源描述 -->
  <view class="section-card">
    <view class="section-title">房源描述</view>
    <text class="description">{{house.description}}</text>
  </view>

  <!-- 配套设施 -->
  <view class="section-card">
    <view class="section-title">配套设施</view>
    <view class="facilities">
      <view class="facility-item" wx:for="{{facilitiesArr}}" wx:key="index">
        <text class="facility-icon">✅</text>
        <text class="facility-name">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 房源发布者 -->
  <view class="section-card">
    <view class="section-title">房源发布者</view>
    <view class="host-info">
      <image class="host-avatar" src="{{house.hostAvatar || '/assets/images/default-avatar.png'}}" mode="aspectFill"></image>
      <view class="host-detail">
        <view class="host-name">{{house.hostName || '房东'}}</view>
        <view class="host-id">ID: {{house.hostId}}</view>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="contact-btn" bindtap="contactLandlord">联系房东</view>
    <view class="book-btn" bindtap="bookNow">立即预订</view>
  </view>
</view>

<!-- 加载状态 -->
<view class="loading-container" wx:if="{{loading}}">
  <text class="loading-text">加载中...</text>
</view>
