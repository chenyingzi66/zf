<!-- pages/tenant/orders/orders.wxml -->
<view class="orders-page">
  <!-- 状态标签栏 -->
  <scroll-view class="tabs-bar" scroll-x enable-flex>
    <view class="tab-item {{activeTab === index ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="value" bindtap="switchTab" data-idx="{{index}}">
      {{item.label}}
    </view>
  </scroll-view>

  <!-- 订单列表 -->
  <view class="order-list">
    <view class="order-card" wx:for="{{list}}" wx:key="id">
      <!-- 订单头部 -->
      <view class="order-head">
        <view class="order-title-wrap">
          <text class="order-house">{{item.houseTitle}}</text>
          <text class="order-rent-type">{{item.rentType || '月租'}}</text>
        </view>
        <text class="order-status" style="color:{{item.statusColor}}">{{item.statusLabel}}</text>
      </view>

      <!-- 订单信息 -->
      <view class="order-body" bindtap="goToDetail" data-id="{{item.id}}">
        <image class="order-img" src="{{item.houseImage || '/assets/images/default-house.png'}}" mode="aspectFill"></image>
        <view class="order-info">
          <view class="order-row">
            <text class="label">入住日期</text>
            <text class="val">{{item.startDate}}</text>
          </view>
          <view class="order-row">
            <text class="label">退房日期</text>
            <text class="val">{{item.endDate}}</text>
          </view>
          <view class="order-row">
            <text class="label">租住时长</text>
            <text class="val">{{item.rentCount || item.months || 1}}{{item.rentUnit || '月'}}</text>
          </view>
          <view class="order-row">
            <text class="label">订单金额</text>
            <text class="val red">¥{{item.totalAmount}}</text>
          </view>
        </view>
      </view>

      <!-- 价格明细 -->
      <view class="order-price-detail">
        <view class="price-row">
          <text class="price-label">租金</text>
          <text class="price-val">¥{{item.rentAmount}}</text>
        </view>
        <view class="price-row">
          <text class="price-label">押金</text>
          <text class="price-val">¥{{item.deposit}}</text>
        </view>
      </view>

      <!-- 订单操作 -->
      <view class="order-foot">
        <text class="order-no">订单号：{{item.orderNo}}</text>
        <view class="order-btns">
          <view class="btn-cancel" wx:if="{{item.orderStatus === 0}}" bindtap="cancelOrder" data-id="{{item.orderNo}}">取消订单</view>
          <view class="btn-contact" wx:if="{{item.orderStatus === 1 || item.orderStatus === 2}}" bindtap="contactLandlord" data-id="{{item.orderNo}}">联系房东</view>
          <view class="btn-detail" bindtap="goToDetail" data-id="{{item.id}}">查看详情</view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{list.length === 0 && !loading}}">
      <text class="empty-icon">📋</text>
      <text class="empty-text">暂无相关订单</text>
      <view class="empty-btn" bindtap="goToHouseList">去看看房源</view>
    </view>

    <!-- 加载中 -->
    <view class="loading-tip" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
  </view>
</view>
