/* pages/tenant/orders/orders.wxss */
.orders-page { min-height: 100vh; background: #F5F5F5; }

/* 标签栏 */
.tabs-bar { display: flex; background: #fff; border-bottom: 1rpx solid #eee; white-space: nowrap; position: sticky; top: 0; z-index: 10; }
.tab-item { display: inline-flex; align-items: center; padding: 0 32rpx; height: 88rpx; font-size: 28rpx; color: #666; flex-shrink: 0; }
.tab-item.active { color: #4A90E2; border-bottom: 4rpx solid #4A90E2; font-weight: 500; }

/* 订单列表 */
.order-list { padding: 20rpx; }

/* 订单卡片 */
.order-card { background: #fff; border-radius: 16rpx; margin-bottom: 20rpx; overflow: hidden; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05); }

/* 订单头部 */
.order-head { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 24rpx; border-bottom: 1rpx solid #F5F5F5; }
.order-title-wrap { display: flex; align-items: center; flex: 1; overflow: hidden; }
.order-house { font-size: 30rpx; font-weight: 600; color: #333; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-right: 12rpx; }
.order-rent-type { font-size: 22rpx; color: #4A90E2; background: #E8F4FF; padding: 4rpx 12rpx; border-radius: 4rpx; flex-shrink: 0; }
.order-status { font-size: 26rpx; font-weight: 500; flex-shrink: 0; margin-left: 16rpx; }

/* 订单主体 */
.order-body { display: flex; padding: 20rpx 24rpx; gap: 20rpx; }
.order-img { width: 180rpx; height: 140rpx; border-radius: 12rpx; flex-shrink: 0; background: #f5f5f5; }
.order-info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
.order-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.order-row:last-child { margin-bottom: 0; }
.label { font-size: 24rpx; color: #999; }
.val { font-size: 24rpx; color: #333; }
.red { color: #FF4444; font-weight: 600; }

/* 价格明细 */
.order-price-detail { display: flex; justify-content: space-around; padding: 16rpx 24rpx; background: #FAFAFA; border-top: 1rpx solid #F5F5F5; }
.price-row { display: flex; flex-direction: column; align-items: center; }
.price-label { font-size: 22rpx; color: #999; margin-bottom: 4rpx; }
.price-val { font-size: 28rpx; color: #333; font-weight: 500; }

/* 订单底部 */
.order-foot { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 24rpx; border-top: 1rpx solid #F5F5F5; }
.order-no { font-size: 22rpx; color: #ccc; }
.order-btns { display: flex; gap: 16rpx; }
.btn-contact, .btn-cancel, .btn-detail { padding: 12rpx 24rpx; border-radius: 30rpx; font-size: 24rpx; border: 2rpx solid; }
.btn-contact { color: #52C41A; border-color: #52C41A; }
.btn-cancel { color: #FF4444; border-color: #FF4444; }
.btn-detail { color: #4A90E2; border-color: #4A90E2; }

/* 空状态 */
.empty-state { display: flex; flex-direction: column; align-items: center; padding: 100rpx 40rpx; }
.empty-icon { font-size: 100rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 28rpx; color: #999; margin-bottom: 24rpx; }
.empty-btn { padding: 16rpx 40rpx; background: #4A90E2; color: #fff; border-radius: 30rpx; font-size: 26rpx; }

/* 加载中 */
.loading-tip { text-align: center; padding: 40rpx; font-size: 26rpx; color: #999; }
