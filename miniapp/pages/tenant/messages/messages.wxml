<view class="messages-page">
  <!-- 顶部统计 -->
  <view class="header-stats">
    <view class="stat-item">
      <text class="stat-num">{{conversationList.length}}</text>
      <text class="stat-label">会话数</text>
    </view>
    <view class="stat-item">
      <text class="stat-num red">{{unreadTotal}}</text>
      <text class="stat-label">未读消息</text>
    </view>
  </view>

  <!-- 会话列表 -->
  <view class="conversation-list">
    <view class="conv-item {{item.unreadCount > 0 ? 'has-unread' : ''}}" 
          wx:for="{{conversationList}}" 
          wx:key="conversationId"
          bindtap="openChat"
          data-conversation-id="{{item.conversationId}}"
          data-house-id="{{item.houseId}}"
          data-house-title="{{item.houseTitle}}"
          data-tenant-id="{{item.tenantId}}"
          data-landlord-id="{{item.landlordId}}"
          data-peer-name="{{item.peerName}}">
      
      <!-- 头像 -->
      <view class="avatar-wrap">
        <image class="avatar" src="{{item.peerAvatar || '/assets/images/default-avatar.png'}}" mode="aspectFill"/>
        <view class="unread-badge" wx:if="{{item.unreadCount > 0}}">{{item.unreadCount > 99 ? '99+' : item.unreadCount}}</view>
      </view>
      
      <!-- 内容区 -->
      <view class="content-wrap">
        <view class="content-top">
          <text class="peer-name">{{item.peerName || '房东'}}</text>
          <text class="last-time">{{item.lastTimeFormatted}}</text>
        </view>
        
        <view class="content-bottom">
          <text class="last-msg {{item.unreadCount > 0 ? 'unread' : ''}}">{{item.lastMsg || '暂无消息'}}</text>
        </view>
        
        <view class="house-info" wx:if="{{item.houseTitle}}">
          <text class="house-icon">🏠</text>
          <text class="house-title">{{item.houseTitle}}</text>
        </view>
      </view>
      

    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{conversationList.length === 0 && !loading}}">
      <text class="empty-icon">💬</text>
      <text class="empty-text">暂无消息记录</text>
      <text class="empty-sub">去浏览房源，联系房东吧～</text>
      <view class="go-home-btn" bindtap="goHome">去浏览房源</view>
    </view>

    <!-- 加载中 -->
    <view class="loading-wrap" wx:if="{{loading}}">
      <view class="loading-dot"></view>
      <text class="loading-text">加载中...</text>
    </view>
  </view>
</view>
