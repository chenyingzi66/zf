/* pages/tenant/messages/messages.wxss */
.messages-page {
  min-height: 100vh;
  background: #F5F5F5;
}

/* 顶部统计 */
.header-stats {
  display: flex;
  background: linear-gradient(135deg, #4A90E2 0%, #5BA3F5 100%);
  padding: 40rpx 0;
}

.stat-item {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid rgba(255,255,255,0.3);
}

.stat-item:last-child {
  border-right: none;
}

.stat-num {
  display: block;
  font-size: 48rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.stat-num.red {
  color: #FF6B6B;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 8rpx;
}

/* 会话列表 */
.conversation-list {
  padding: 20rpx;
}

.conv-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  position: relative;
  overflow: hidden;
  transition: all 0.3s;
}

.conv-item:active {
  background: #F9F9F9;
  transform: scale(0.98);
}

/* 新消息标记条 */
.conv-item.has-unread::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: #FF4444;
}

/* 头像 */
.avatar-wrap {
  position: relative;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #F0F0F0;
  border: 2rpx solid #F0F0F0;
}

/* 在线状态 */
.online-indicator {
  position: absolute;
  bottom: 4rpx;
  right: 4rpx;
  width: 20rpx;
  height: 20rpx;
  background: #52C41A;
  border-radius: 50%;
  border: 4rpx solid #FFFFFF;
}

.unread-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background: linear-gradient(135deg, #FF4444 0%, #FF6B6B 100%);
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  min-width: 32rpx;
  text-align: center;
  border: 4rpx solid #FFFFFF;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(255,68,68,0.3);
  animation: badgePulse 2s infinite;
}

@keyframes badgePulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

/* 内容区 */
.content-wrap {
  flex: 1;
  min-width: 0;
}

.content-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.peer-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  margin-right: 16rpx;
}

.last-time {
  font-size: 22rpx;
  color: #999999;
  flex-shrink: 0;
}

.content-bottom {
  margin-bottom: 8rpx;
}

.last-msg {
  font-size: 26rpx;
  color: #999999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.last-msg.unread {
  color: #333333;
  font-weight: 500;
}

/* 房源信息 */
.house-info {
  display: flex;
  align-items: center;
  background: #F0F7FF;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  margin-top: 8rpx;
}

.house-icon {
  font-size: 22rpx;
  margin-right: 6rpx;
}

.house-title {
  font-size: 22rpx;
  color: #4A90E2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 500;
}

/* 删除按钮 */
.delete-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  border-radius: 50%;
  transition: all 0.3s;
}

.delete-btn:active {
  background: #F5F5F5;
}

.delete-icon {
  font-size: 40rpx;
  color: #CCCCCC;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666666;
  margin-bottom: 16rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 40rpx;
}

.go-home-btn {
  background: linear-gradient(135deg, #4A90E2 0%, #5BA3F5 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  padding: 24rpx 60rpx;
  border-radius: 40rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(74,144,226,0.3);
}

.go-home-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 加载中 */
.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.loading-dot {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #F0F0F0;
  border-top-color: #4A90E2;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-right: 16rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #999999;
}

/* 新消息提示 */
.new-message-toast {
  position: fixed;
  top: 100rpx;
  left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(135deg, #4A90E2 0%, #5BA3F5 100%);
  color: #fff;
  padding: 20rpx 40rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(74,144,226,0.4);
  animation: slideDown 0.3s ease-out;
  z-index: 1000;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateX(-50%) translateY(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
}
