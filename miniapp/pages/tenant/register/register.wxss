/* pages/tenant/register/register.wxss */

.register-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #F0F7FF 0%, #FFFFFF 100%);
  padding: 80rpx 40rpx;
}

.register-header {
  margin-bottom: 60rpx;
  text-align: center;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #999999;
}

.form {
  display: flex;
  flex-direction: column;
}

.field-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.field-label {
  width: 140rpx;
  font-size: 28rpx;
  color: #333333;
}

.field-input {
  flex: 1;
  height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid #E6E6E6;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.code-btn {
  width: 160rpx;
  height: 64rpx;
  line-height: 64rpx;
  margin-left: 16rpx;
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  color: #FFFFFF;
  text-align: center;
  border-radius: 32rpx;
  font-size: 26rpx;
}

.code-btn.disabled {
  opacity: 0.5;
}

.submit-btn {
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  text-align: center;
  line-height: 96rpx;
  margin-top: 30rpx;
}

.submit-btn.disabled {
  opacity: 0.5;
}

.agreement {
  margin: 28rpx 0 18rpx 0;
  padding: 18rpx 18rpx 14rpx 18rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  border-radius: 18rpx;
}

.agreement-item {
  display: flex;
  align-items: flex-start;
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.75);
  line-height: 1.4;
}

.agreement-item .agreement-checkbox {
  margin-top: 4rpx;
  margin-right: 12rpx;
}

.agreement-text-wrap {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}

.agreement-text,
.agreement-link {
  line-height: 1.4;
}

.agreement-text {
  color: rgba(0, 0, 0, 0.7);
}

.agreement-link {
  color: #3c70f4;
  text-decoration: underline;
  margin: 0 4rpx;
}

.tips {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #999999;
  text-align: center;
}

.switch-role {
  margin-top: 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666666;
}

.link {
  color: #4A90E2;
  margin-left: 8rpx;
}
