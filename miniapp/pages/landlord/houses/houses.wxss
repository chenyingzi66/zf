/* pages/landlord/houses/houses.wxss */
.houses-page { 
  min-height: 100vh; 
  background: #F5F5F5; 
  padding-bottom: 40rpx;
}

/* 搜索栏 */
.search-bar { 
  display: flex; 
  align-items: center; 
  background: #fff; 
  padding: 16rpx 20rpx; 
  gap: 12rpx; 
  border-bottom: 1rpx solid #eee; 
  position: sticky;
  top: 0;
  z-index: 100;
}

.search-input { 
  flex: 1; 
  height: 72rpx; 
  background: #F5F5F5; 
  border-radius: 36rpx; 
  padding: 0 24rpx; 
  font-size: 28rpx; 
}

.search-btn { 
  padding: 16rpx 24rpx; 
  background: #4A90E2; 
  color: #fff; 
  border-radius: 36rpx; 
  font-size: 26rpx; 
  flex-shrink: 0; 
}

.publish-btn { 
  padding: 16rpx 24rpx; 
  background: #52C41A; 
  color: #fff; 
  border-radius: 36rpx; 
  font-size: 26rpx; 
  flex-shrink: 0; 
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  background: #fff;
  padding: 20rpx 30rpx;
  gap: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.filter-item {
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 30rpx;
}

.filter-item.active {
  background: #4A90E2;
  color: #fff;
}

/* 房源列表 */
.house-list { 
  padding: 20rpx; 
}

.house-card { 
  background: #fff; 
  border-radius: 16rpx; 
  margin-bottom: 20rpx; 
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.card-top { 
  display: flex; 
  padding: 20rpx; 
  gap: 20rpx; 
}

.house-img { 
  width: 200rpx; 
  height: 160rpx; 
  border-radius: 12rpx; 
  flex-shrink: 0; 
  background: #f5f5f5;
}

.house-meta { 
  flex: 1; 
  display: flex; 
  flex-direction: column; 
  justify-content: space-between;
  min-width: 0;
}

.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.house-title { 
  font-size: 30rpx; 
  font-weight: 600; 
  color: #333; 
  line-height: 1.4;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.house-region { 
  font-size: 24rpx; 
  color: #999;
  margin-top: 8rpx;
}

.house-address {
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.house-bottom { 
  display: flex; 
  justify-content: space-between; 
  align-items: center;
  margin-top: 8rpx;
}

.house-price { 
  font-size: 32rpx; 
  font-weight: bold; 
  color: #FF4444; 
}

.house-type {
  font-size: 24rpx;
  color: #999;
}

.audit-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}

.audit-status {
  font-size: 24rpx;
}

.view-count {
  font-size: 22rpx;
  color: #ccc;
}

/* 操作按钮 */
.card-actions { 
  display: flex; 
  border-top: 1rpx solid #F5F5F5; 
}

.action-btn { 
  flex: 1; 
  height: 80rpx; 
  line-height: 80rpx; 
  text-align: center; 
  font-size: 28rpx;
  transition: background 0.2s;
}

.action-btn:active {
  background: #f5f5f5;
}

.edit-btn { 
  color: #4A90E2; 
  border-right: 1rpx solid #F5F5F5; 
}

.toggle-btn { 
  color: #FA8C16; 
  border-right: 1rpx solid #F5F5F5; 
}

.del-btn { 
  color: #FF4444; 
}

/* 空状态 */
.empty-state { 
  display: flex; 
  flex-direction: column; 
  align-items: center; 
  padding: 100rpx 40rpx; 
}

.empty-icon { 
  font-size: 100rpx; 
  margin-bottom: 24rpx; 
}

.empty-text { 
  font-size: 30rpx; 
  color: #666; 
}

.go-publish { 
  margin-top: 40rpx; 
  padding: 20rpx 60rpx; 
  background: #52C41A; 
  color: #fff; 
  border-radius: 40rpx; 
  font-size: 28rpx; 
}

/* 加载提示 */
.loading-tip { 
  text-align: center; 
  padding: 40rpx; 
  font-size: 26rpx; 
  color: #999; 
}
