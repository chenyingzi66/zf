/* pages/landlord/order-detail/order-detail.wxss */
.od-page { 
  min-height: 100vh; 
  background: #F5F5F5; 
  padding-bottom: 140rpx; 
}

/* 加载中 */
.loading-page { 
  display: flex; 
  flex-direction: column;
  align-items: center; 
  justify-content: center; 
  height: 100vh; 
  font-size: 28rpx; 
  color: #999; 
  gap: 20rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #E6F4FF;
  border-top-color: #4A90E2;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 状态头部 */
.status-header { 
  padding: 50rpx 32rpx; 
  display: flex; 
  flex-direction: column; 
  align-items: center; 
  gap: 12rpx; 
}

.status-icon {
  font-size: 60rpx;
  margin-bottom: 10rpx;
}

.status-text { 
  font-size: 40rpx; 
  font-weight: bold; 
  color: #fff; 
}

.status-desc {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
}

.order-no { 
  font-size: 24rpx; 
  color: rgba(255,255,255,0.8); 
  margin-top: 10rpx;
}

/* 卡片样式 */
.section-card {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  padding: 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

/* 房源信息 */
.house-info {
  display: flex;
  padding: 24rpx;
  gap: 20rpx;
}

.house-img {
  width: 180rpx;
  height: 130rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #f5f5f5;
}

.house-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.house-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.house-address {
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.house-tags {
  display: flex;
  gap: 12rpx;
}

.tag {
  padding: 6rpx 16rpx;
  background: #F5F5F5;
  border-radius: 6rpx;
  font-size: 24rpx;
  color: #666;
}

/* 信息行 */
.info-row {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.info-label {
  font-size: 28rpx;
  color: #999;
  width: 100rpx;
  flex-shrink: 0;
}

.info-val {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.info-val.phone {
  color: #4A90E2;
}

.info-action {
  font-size: 26rpx;
  color: #4A90E2;
  padding: 8rpx 20rpx;
  background: #E6F4FF;
  border-radius: 20rpx;
}

/* 费用明细 */
.info-row.total {
  background: #FAFAFA;
  margin-top: 10rpx;
}

.info-row.total .info-label {
  font-weight: 600;
  color: #333;
}

.total-price {
  font-size: 36rpx !important;
  font-weight: bold;
  color: #FF4444 !important;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  background: #fff;
  padding: 20rpx 30rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.08);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn:active {
  opacity: 0.8;
}

.contact-btn { 
  background: #F5F5F5; 
  color: #333; 
  flex: 0.8;
}

.reject-btn {
  background: #FFF1F0;
  color: #FF4444;
  border: 2rpx solid #FF4444;
}

.confirm-btn { 
  background: #52C41A; 
  color: #fff; 
}

.complete-btn { 
  background: #FA8C16; 
  color: #fff; 
}

.btn.disabled { 
  opacity: 0.5; 
}
