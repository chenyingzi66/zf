<!-- pages/landlord/order-detail/order-detail.wxml -->
<view class="od-page">
  <!-- 加载中 -->
  <view class="loading-page" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text>加载中...</text>
  </view>

  <block wx:if="{{order && !loading}}">
    <!-- 状态头部 -->
    <view class="status-header" style="background: linear-gradient(135deg, {{order.statusColor}}, {{order.statusColor}}99)">
      <view class="status-icon">{{order.statusIcon}}</view>
      <text class="status-text">{{order.statusLabel}}</text>
      <text class="status-desc">{{order.statusDesc}}</text>
      <text class="order-no">订单编号：{{order.orderNo}}</text>
    </view>

    <!-- 房源信息 -->
    <view class="section-card">
      <view class="section-title">房源信息</view>
      <view class="house-info">
        <image class="house-img" src="{{order.houseImage || '/assets/images/default-house.png'}}" mode="aspectFill"></image>
        <view class="house-meta">
          <text class="house-title">{{order.houseTitle || '房源'}}</text>
          <text class="house-address">{{order.houseAddress || ''}}</text>
          <view class="house-tags">
            <text class="tag">{{order.rentType}}</text>
            <text class="tag">¥{{order.rentPrice}}/{{order.rentUnit}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 租客信息 -->
    <view class="section-card">
      <view class="section-title">租客信息</view>
      <view class="info-row">
        <text class="info-icon">👤</text>
        <text class="info-label">姓名</text>
        <text class="info-val">{{order.tenantName}}</text>
      </view>
      <view class="info-row" bindtap="callTenant">
        <text class="info-icon">📞</text>
        <text class="info-label">电话</text>
        <text class="info-val phone">{{order.tenantPhone || '未填写'}}</text>
        <text class="info-action" wx:if="{{order.tenantPhone}}">拨打</text>
      </view>
    </view>

    <!-- 租期信息 -->
    <view class="section-card">
      <view class="section-title">租期信息</view>
      <view class="info-row">
        <text class="info-icon">📅</text>
        <text class="info-label">入住</text>
        <text class="info-val">{{order.checkInDate || '未设置'}}</text>
      </view>
      <view class="info-row">
        <text class="info-icon">🏁</text>
        <text class="info-label">退房</text>
        <text class="info-val">{{order.checkOutDate || '未设置'}}</text>
      </view>
      <view class="info-row">
        <text class="info-icon">⏱️</text>
        <text class="info-label">租期</text>
        <text class="info-val">{{order.rentCountDisplay}}{{order.rentUnit}}</text>
      </view>
    </view>

    <!-- 费用明细 -->
    <view class="section-card">
      <view class="section-title">费用明细</view>
      <view class="info-row">
        <text class="info-label">租金</text>
        <text class="info-val price">¥{{order.rentAmount || 0}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">押金</text>
        <text class="info-val price">¥{{order.deposit || 0}}</text>
      </view>
      <view class="info-row total">
        <text class="info-label">合计</text>
        <text class="info-val price total-price">¥{{order.displayAmount}}</text>
      </view>
    </view>

    <!-- 订单信息 -->
    <view class="section-card">
      <view class="section-title">订单信息</view>
      <view class="info-row">
        <text class="info-label">订单编号</text>
        <text class="info-val">{{order.orderNo}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">创建时间</text>
        <text class="info-val">{{order.createTime}}</text>
      </view>
      <view class="info-row" wx:if="{{order.remark}}">
        <text class="info-label">备注</text>
        <text class="info-val">{{order.remark}}</text>
      </view>
    </view>

    <!-- 底部操作栏 -->
    <view class="bottom-bar">
      <!-- 待确认状态 -->
      <block wx:if="{{order.orderStatus === 0}}">
        <view class="btn contact-btn" bindtap="contactTenant">联系租客</view>
        <view class="btn reject-btn" bindtap="rejectOrder">拒绝</view>
        <view class="btn confirm-btn" bindtap="confirmOrder">确认订单</view>
      </block>

      <!-- 已确认状态 -->
      <block wx:if="{{order.orderStatus === 1}}">
        <view class="btn contact-btn" bindtap="contactTenant">联系租客</view>
        <view class="btn complete-btn" bindtap="startRenting">确认入住</view>
      </block>

      <!-- 租住中状态 -->
      <block wx:if="{{order.orderStatus === 2}}">
        <view class="btn contact-btn" bindtap="contactTenant">联系租客</view>
        <view class="btn complete-btn" bindtap="completeOrder">完结订单</view>
      </block>

      <!-- 已完结/已取消/已拒绝 -->
      <block wx:if="{{order.orderStatus === 3 || order.orderStatus === 4 || order.orderStatus === 5}}">
        <view class="btn contact-btn" bindtap="contactTenant">联系租客</view>
      </block>
    </view>
  </block>
</view>
