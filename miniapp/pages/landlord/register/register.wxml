<!-- pages/landlord/register/register.wxml -->
<view class="register-container">
  <view class="register-header">
    <text class="title">房东注册</text>
    <text class="subtitle">注册后可使用手机号+密码登录</text>
  </view>

  <view class="form">
    <view class="field-row">
      <text class="field-label">手机号</text>
      <input class="field-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onInput" data-field="phone" />
    </view>

    <view class="field-row">
      <text class="field-label">密码</text>
      <input class="field-input" password placeholder="请输入密码" value="{{password}}" bindinput="onInput" data-field="password" />
    </view>

    <view class="field-row">
      <text class="field-label">验证码</text>
      <input class="field-input" type="number" maxlength="6" placeholder="请输入验证码" value="{{code}}" bindinput="onInput" data-field="code" />
      <view class="code-btn {{sendingCode ? 'disabled' : ''}}" bindtap="sendCode">
        {{sendingCode ? countdown + 's' : '获取验证码'}}
      </view>
    </view>

    <view class="submit-btn {{submitting ? 'disabled' : ''}}" bindtap="register">
      {{submitting ? '注册中...' : '立即注册'}}
    </view>

    <view class="agreement">
      <checkbox-group bindchange="handleAgreementChange">
        <label class="agreement-item">
          <checkbox class="agreement-checkbox" value="agree" checked="{{agreed}}" color="#4A90E2"/>
          <view class="agreement-text-wrap">
            <text class="agreement-text">我已阅读并同意</text>
            <text class="agreement-link" bindtap="showAgreement">《用户协议》</text>
            <text class="agreement-text">和</text>
            <text class="agreement-link" bindtap="showPrivacy">《隐私政策》</text>
          </view>
        </label>
      </checkbox-group>
    </view>

    <view class="tips">
      温馨提示：本演示验证码固定为 123456。
    </view>

    <view class="switch-role">
      <text>已有账号？</text>
      <text class="link" bindtap="goLogin">去登录</text>
    </view>
  </view>
</view>
