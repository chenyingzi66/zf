<!-- pages/landlord/tenants/tenants.wxml -->
<view class="tenants-page">
  <!-- 顶部统计 -->
  <view class="header-stats">
    <view class="stat-item">
      <text class="stat-num">{{list.length}}</text>
      <text class="stat-label">租客总数</text>
    </view>
    <view class="stat-item">
      <text class="stat-num red">{{unreadTotal}}</text>
      <text class="stat-label">未读消息</text>
    </view>
  </view>

  <!-- 租客列表 -->
  <view class="tenant-list">
    <view class="tenant-card {{item.unreadCount > 0 ? 'has-new' : ''}}" wx:for="{{list}}" wx:key="id">
      <view class="card-header">
        <view class="card-left">
          <view class="avatar-wrap">
            <image class="t-avatar" src="{{item.avatar || '/assets/images/default-avatar.png'}}" mode="aspectFill"></image>
            <view class="online-indicator" wx:if="{{item.isOnline}}"></view>
          </view>
          <view class="t-info">
            <view class="t-name-row">
              <text class="t-name">{{item.name}}</text>
              <view class="t-unread" wx:if="{{item.unreadCount > 0}}">{{item.unreadCount > 99 ? '99+' : item.unreadCount}}</view>
            </view>
            <text class="t-id">用户ID: {{item.tenantId}}</text>
            <text class="t-house">🏠 {{item.houseTitle || '未知房源'}}</text>
            <text class="t-period" wx:if="{{item.contractStart !== '-'}}">📅 {{item.contractStart}} ~ {{item.contractEnd}}</text>
            <text class="t-phone" wx:if="{{item.phone}}">{{item.phone}}</text>
            
            <!-- 消息预览 -->
            <view class="t-message-row" wx:if="{{item.lastMsg}}">
              <text class="t-last-msg {{item.unreadCount > 0 ? 'unread' : ''}}">{{item.lastMsg}}</text>
              <text class="t-last-time" wx:if="{{item.lastTimeFormatted}}">{{item.lastTimeFormatted}}</text>
            </view>
            <text class="t-no-message" wx:else>💬 暂无消息</text>
          </view>
        </view>

      </view>
      
      <view class="card-actions">
        <view class="action-btn chat-btn {{item.unreadCount > 0 ? 'has-new' : ''}}" bindtap="contactTenant" data-tenant-id="{{item.tenantId}}" data-house-id="{{item.houseId}}" data-house-title="{{item.houseTitle}}">
          <text wx:if="{{item.unreadCount > 0}}">🔔 新消息</text>
          <text wx:else>💬 沟通</text>
        </view>
        <view class="action-btn order-btn" bindtap="viewOrders" data-tenant-id="{{item.tenantId}}" data-house-id="{{item.houseId}}">📋 租赁记录</view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{list.length === 0 && !loading}}">
      <text class="empty-icon">👥</text>
      <text class="empty-text">暂无租客数据</text>
      <text style="font-size: 26rpx; color: #999; margin-top: 16rpx;">租客咨询房源后会显示在这里</text>
    </view>
    
    <!-- 加载中 -->
    <view class="loading-tip" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
  </view>
</view>
