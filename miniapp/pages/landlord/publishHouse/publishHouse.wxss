/* pages/landlord/publishHouse/publishHouse.wxss */

.publish-page {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 40rpx;
}

.section-card {
  background: #FFFFFF;
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
  padding: 24rpx 30rpx 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.form-row:last-child {
  border-bottom: none;
}

.fl {
  width: 160rpx;
  font-size: 28rpx;
  color: #666666;
}

.fi {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  text-align: right;
}

.picker-val {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  text-align: right;
}

.picker-val.disabled {
  color: #CCCCCC;
}

/* 配套设施 */
.facility-list {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 30rpx;
  gap: 16rpx;
}

.facility-item {
  padding: 16rpx 28rpx;
  background: #F5F5F5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666666;
}

.facility-item.active {
  background: rgba(74, 144, 226, 0.1);
  color: #4A90E2;
  border: 1rpx solid #4A90E2;
}

/* 描述输入框 */
.desc-input {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

/* 图片上传 */
.image-list {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 30rpx;
  gap: 16rpx;
}

.img-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.preview-img {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.del-img {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background: #FF4444;
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.add-img {
  width: 200rpx;
  height: 200rpx;
  background: #F5F5F5;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 60rpx;
  color: #CCCCCC;
}

.add-tip {
  font-size: 24rpx;
  color: #999999;
  margin-top: 10rpx;
}

.img-tip {
  display: block;
  padding: 0 30rpx 20rpx;
  font-size: 24rpx;
  color: #999999;
}

.required {
  color: #FF4444;
}

/* 提交按钮 */
.submit-btn {
  margin: 40rpx 20rpx;
  padding: 28rpx 0;
  text-align: center;
  background: linear-gradient(135deg, #f5576c 0%, #f093fb 100%);
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.submit-btn.disabled {
  opacity: 0.6;
}
