<!-- pages/landlord/stats/stats.wxml -->
<view class="stats-page">
  <!-- 月份切换 -->
  <view class="month-bar">
    <view class="month-btn" bindtap="prevMonth">‹</view>
    <text class="month-text">{{curMonth}} 月度数据</text>
    <view class="month-btn" bindtap="nextMonth">›</view>
  </view>

  <block wx:if="{{stats && !loading}}">
    <!-- 核心指标 -->
    <view class="metrics-grid">
      <view class="metric-card income">
        <text class="metric-val">¥{{stats.monthIncome}}</text>
        <text class="metric-label">月度收益</text>
      </view>
      <view class="metric-card orders">
        <text class="metric-val">{{stats.monthOrders}}</text>
        <text class="metric-label">本月订单</text>
      </view>
      <view class="metric-card tenants">
        <text class="metric-val">{{stats.activeTenants}}</text>
        <text class="metric-label">在住租客</text>
      </view>
      <view class="metric-card views">
        <text class="metric-val">{{stats.totalViews}}</text>
        <text class="metric-label">总浏览量</text>
      </view>
    </view>

    <!-- 房源统计 -->
    <view class="section-card">
      <view class="section-title">房源概况</view>
      <view class="stat-row"><text class="sl">总房源数</text><text class="sv">{{stats.totalHouses}} 套</text></view>
      <view class="stat-row"><text class="sl">已出租</text><text class="sv green">{{stats.rentedHouses}} 套</text></view>
      <view class="stat-row"><text class="sl">空置</text><text class="sv orange">{{stats.vacantHouses}} 套</text></view>
      <view class="stat-row"><text class="sl">出租率</text><text class="sv blue">{{stats.rentRate}}%</text></view>
    </view>

    <!-- 订单统计 -->
    <view class="section-card">
      <view class="section-title">订单统计</view>
      <view class="stat-row"><text class="sl">待确认</text><text class="sv orange">{{stats.pendingOrders}} 单</text></view>
      <view class="stat-row"><text class="sl">已完结</text><text class="sv green">{{stats.completedOrders}} 单</text></view>
      <view class="stat-row"><text class="sl">已取消/拒绝</text><text class="sv red">{{stats.cancelledOrders}} 单</text></view>
      <view class="stat-row"><text class="sl">订单转化率</text><text class="sv blue">{{stats.conversionRate}}%</text></view>
    </view>

    <!-- 累计数据 -->
    <view class="section-card">
      <view class="section-title">累计数据</view>
      <view class="stat-row"><text class="sl">累计收益</text><text class="sv">¥{{stats.totalIncome}}</text></view>
      <view class="stat-row"><text class="sl">累计订单</text><text class="sv">{{stats.totalOrders}} 单</text></view>
      <view class="stat-row"><text class="sl">累计租客</text><text class="sv">{{stats.totalTenants}} 人</text></view>
    </view>
  </block>

  <view class="loading-page" wx:if="{{loading}}"><text>加载中...</text></view>
  <view class="empty-state" wx:if="{{!stats && !loading}}">
    <text class="empty-icon">📊</text>
    <text class="empty-text">暂无统计数据</text>
  </view>
</view>
