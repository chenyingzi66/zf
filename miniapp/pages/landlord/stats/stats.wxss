/* pages/landlord/stats/stats.wxss */
.stats-page { min-height: 100vh; background: #F5F5F5; padding-bottom: 40rpx; }
.month-bar { display: flex; align-items: center; justify-content: space-between; background: #fff; padding: 24rpx 32rpx; border-bottom: 1rpx solid #eee; }
.month-btn { width: 60rpx; height: 60rpx; line-height: 60rpx; text-align: center; font-size: 40rpx; color: #4A90E2; }
.month-text { font-size: 30rpx; font-weight: 500; color: #333; }
.metrics-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; padding: 20rpx; }
.metric-card { background: #fff; border-radius: 16rpx; padding: 30rpx 20rpx; display: flex; flex-direction: column; align-items: center; gap: 10rpx; }
.metric-card.income { background: linear-gradient(135deg, #FF6B6B, #FF4444); }
.metric-card.orders { background: linear-gradient(135deg, #4ECDC4, #2196F3); }
.metric-card.tenants { background: linear-gradient(135deg, #52C41A, #73D13D); }
.metric-card.views { background: linear-gradient(135deg, #FA8C16, #FAAD14); }
.metric-val { font-size: 40rpx; font-weight: bold; color: #fff; }
.metric-label { font-size: 24rpx; color: rgba(255,255,255,0.85); }
.section-card { background: #fff; margin: 0 20rpx 20rpx; border-radius: 16rpx; padding: 24rpx 30rpx; }
.section-title { font-size: 28rpx; font-weight: bold; color: #333; margin-bottom: 20rpx; padding-bottom: 16rpx; border-bottom: 1rpx solid #F5F5F5; }
.stat-row { display: flex; justify-content: space-between; align-items: center; padding: 14rpx 0; border-bottom: 1rpx solid #F5F5F5; }
.stat-row:last-child { border-bottom: none; }
.sl { font-size: 28rpx; color: #666; }
.sv { font-size: 28rpx; color: #333; font-weight: 500; }
.sv.green { color: #52C41A; }
.sv.orange { color: #FA8C16; }
.sv.blue { color: #4A90E2; }
.sv.red { color: #FF4444; }
.loading-page { display: flex; align-items: center; justify-content: center; height: 400rpx; font-size: 28rpx; color: #999; }
.empty-state { display: flex; flex-direction: column; align-items: center; padding: 100rpx 40rpx; }
.empty-icon { font-size: 100rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 30rpx; color: #999; }
