/* pages/landlord/index/index.wxss */

.li-page {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 40rpx;
}

/* 顶部欢迎区 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 30rpx;
  background: linear-gradient(135deg, #f5576c 0%, #f093fb 100%);
}

.header-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.5);
}

.welcome {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}

.name {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-top: 8rpx;
}

.profile-btn {
  padding: 16rpx 32rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #FFFFFF;
}

/* 数据统计卡片 */
.stats-grid {
  display: flex;
  background: #FFFFFF;
  margin: -40rpx 20rpx 20rpx;
  border-radius: 16rpx;
  padding: 30rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}

.stat-item {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #EEEEEE;
}

.stat-item:last-child {
  border-right: none;
}

.stat-num {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
  color: #333333;
}

.stat-num.orange {
  color: #FA8C16;
}

.stat-num.green {
  color: #52C41A;
  font-size: 36rpx;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* 快捷入口 */
.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
  padding: 30rpx 30rpx 20rpx;
}

.shortcut-grid {
  display: flex;
  flex-wrap: wrap;
  background: #FFFFFF;
  margin: 0 20rpx;
  border-radius: 16rpx;
  padding: 20rpx 10rpx;
}

.shortcut-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  position: relative;
}

.sc-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.sc-label {
  font-size: 26rpx;
  color: #666666;
}

.badge {
  position: absolute;
  top: 10rpx;
  right: 30rpx;
  background: #FF4444;
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  min-width: 32rpx;
  text-align: center;
}

.badge.red {
  background: #FF4444;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.1); }
  100% { transform: scale(1); }
}

/* 待处理订单 */
.pending-list {
  background: #FFFFFF;
  margin: 0 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.pending-item {
  display: flex;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid #EEEEEE;
}

.pending-item:last-child {
  border-bottom: none;
}

.pi-left {
  flex: 1;
}

.pi-house {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 8rpx;
}

.pi-tenant {
  display: block;
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 4rpx;
}

.pi-date {
  display: block;
  font-size: 22rpx;
  color: #999999;
}

.pi-right {
  text-align: right;
}

.pi-amount {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #FF4444;
  margin-bottom: 8rpx;
}

.pi-action {
  display: block;
  font-size: 24rpx;
  color: #4A90E2;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 60rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}
