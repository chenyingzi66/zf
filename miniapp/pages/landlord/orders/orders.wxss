/* pages/landlord/orders/orders.wxss */
.orders-page {
  min-height: 100vh;
  background: #F5F5F5;
  display: flex;
  flex-direction: column;
}

/* 顶部状态栏 */
.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.header-refresh {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.refresh-icon {
  font-size: 28rpx;
}

.refresh-text {
  font-size: 24rpx;
  color: #999;
}

/* Tab 切换 */
.tab-bar {
  background: #fff;
  border-bottom: 1rpx solid #eee;
  flex-shrink: 0;
}

.tab-list {
  display: flex;
  padding: 0 20rpx;
}

.tab-item {
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  color: #666;
  position: relative;
  flex-shrink: 0;
}

.tab-item.active {
  color: #4A90E2;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: #4A90E2;
  border-radius: 3rpx;
}

/* 订单列表 */
.order-list {
  flex: 1;
  padding: 20rpx;
}

.order-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

/* 卡片头部 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.header-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.order-no {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.order-time {
  font-size: 22rpx;
  color: #999;
}

.status-badge {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.status-icon {
  font-size: 22rpx;
}

/* 房源信息 */
.card-body {
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.house-info {
  display: flex;
  gap: 20rpx;
}

.house-img {
  width: 160rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #f5f5f5;
}

.house-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.house-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.house-address {
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.house-tags {
  display: flex;
  gap: 12rpx;
}

.tag {
  padding: 4rpx 12rpx;
  background: #F5F5F5;
  border-radius: 6rpx;
  font-size: 22rpx;
  color: #666;
}

/* 租客与租期信息 */
.card-info {
  padding: 16rpx 24rpx;
  background: #FAFAFA;
}

.info-row {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}

.info-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.info-label {
  font-size: 24rpx;
  color: #999;
  width: 60rpx;
  flex-shrink: 0;
}

.info-val {
  font-size: 24rpx;
  color: #333;
  flex: 1;
}

.info-phone {
  font-size: 24rpx;
  color: #4A90E2;
  margin-left: 16rpx;
}

/* 金额与操作 */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
}

.amount-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.amount-label {
  font-size: 22rpx;
  color: #999;
}

.amount-val {
  font-size: 36rpx;
  font-weight: bold;
  color: #FF4444;
}

.action-btns {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  padding: 16rpx 28rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 500;
  transition: all 0.2s;
}

.action-btn:active {
  transform: scale(0.96);
  opacity: 0.8;
}

.action-btn.reject {
  background: #FFF1F0;
  color: #FF4444;
  border: 1rpx solid #FF4444;
}

.action-btn.confirm {
  background: #52C41A;
  color: #fff;
}

.action-btn.contact {
  background: #E6F4FF;
  color: #4A90E2;
  border: 1rpx solid #4A90E2;
}

.action-btn.complete {
  background: #FA8C16;
  color: #fff;
}

.action-btn.detail {
  background: #F5F5F5;
  color: #666;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #999;
}

/* 加载中 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #E6F4FF;
  border-top-color: #4A90E2;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

/* 底部安全区 */
.safe-bottom {
  height: 40rpx;
}
