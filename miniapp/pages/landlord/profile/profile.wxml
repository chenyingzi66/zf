<!-- pages/landlord/profile/profile.wxml -->
<view class="profile-page" wx:if="{{landlord}}">
  <!-- 头部信息 -->
  <view class="profile-header">
    <view class="avatar-wrap" bindtap="showEditDialog" data-field="avatar">
      <image class="avatar" src="{{landlord.avatar || '/assets/images/default-avatar.png'}}" mode="aspectFill"></image>
      <view class="avatar-edit">换</view>
    </view>
    <view class="info">
      <view class="name-row">
        <text class="name">{{landlord.name || '房东'}}</text>
        <text class="cert-badge" wx:if="{{landlord.certStatus === 2}}">已认证</text>
        <text class="cert-badge uncert" wx:elif="{{landlord.certStatus === 3}}">未认证</text>
        <text class="cert-badge pending" wx:else>审核中</text>
      </view>
      <text class="host-id">ID: {{landlord.hostId || '-'}}</text>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="section-card">
    <view class="section-title">基本信息</view>
    <view class="info-row" bindtap="showEditDialog" data-field="name">
      <text class="il">房东名称</text>
      <view class="ir">
        <text class="iv">{{landlord.name || '未设置'}}</text>
        <text class="edit-arrow">›</text>
      </view>
    </view>
    <view class="info-row">
      <text class="il">手机号</text>
      <text class="iv">{{landlord.phone}}</text>
    </view>
    <view class="info-row" bindtap="showEditDialog" data-field="realName">
      <text class="il">真实姓名</text>
      <view class="ir">
        <text class="iv">{{landlord.realName || '未填写'}}</text>
        <text class="edit-arrow">›</text>
      </view>
    </view>
    <view class="info-row" bindtap="showEditDialog" data-field="idCard">
      <text class="il">身份证号</text>
      <view class="ir">
        <text class="iv">{{landlord.idCardMasked || '未填写'}}</text>
        <text class="edit-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-card">
    <view class="menu-item" bindtap="goFeedback">
      <text class="menu-icon">📢</text><text class="menu-text">平台反馈</text><text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 退出 -->
  <view class="logout-btn" bindtap="logout">退出登录</view>

  <view class="version">随心住 v1.0.0 · 房东端</view>
</view>

<view class="loading-page" wx:if="{{loading && !landlord}}">
  <text>加载中...</text>
</view>
