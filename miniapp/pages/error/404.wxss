/* pages/error/404.wxss */
.page-404 { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; background: #F5F5F5; padding: 60rpx; }
.icon { font-size: 160rpx; margin-bottom: 40rpx; }
.title { font-size: 40rpx; font-weight: bold; color: #333; margin-bottom: 20rpx; }
.desc { font-size: 28rpx; color: #999; margin-bottom: 60rpx; text-align: center; }
.back-btn { padding: 24rpx 80rpx; background: #4A90E2; color: #fff; border-radius: 50rpx; font-size: 30rpx; }
