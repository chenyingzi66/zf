<!-- pages/chat/chat.wxml -->
<view class="chat-page">

  <!-- ===== 会话列表（TabBar 入口，无指定 conversationId 时展示） ===== -->
  <block wx:if="{{showConvList}}">
    <view class="conv-loading" wx:if="{{convLoading}}">
      <view class="loading-dot"></view>
      <text class="loading-text">加载中...</text>
    </view>

    <view class="conv-empty" wx:elif="{{convList.length === 0}}">
      <text class="empty-icon">💬</text>
      <text class="empty-text">暂无消息记录</text>
      <text class="empty-sub">去浏览房源，向房东发消息吧～</text>
    </view>

    <scroll-view class="conv-list" scroll-y wx:else>
      <view class="conv-item" wx:for="{{convList}}" wx:key="conversationId"
        bindtap="openConversation"
        data-conversation-id="{{item.conversationId}}"
        data-house-id="{{item.houseId}}"
        data-house-title="{{item.houseTitle}}"
        data-peer-id="{{item.peerId}}"
        data-tenant-id="{{item.tenantId}}"
        data-landlord-id="{{item.landlordId}}">
        <image class="conv-avatar" src="{{item.peerAvatar || '/assets/images/default-avatar.png'}}" mode="aspectFill"/>
        <view class="conv-info">
          <view class="conv-top">
            <text class="conv-name">{{item.peerName}}</text>
            <text class="conv-time">{{item.lastTime}}</text>
          </view>
          <view class="conv-bottom">
            <text class="conv-last-msg">{{item.lastMsg}}</text>
            <view class="conv-badge" wx:if="{{item.unreadCount > 0}}">{{item.unreadCount}}</view>
          </view>
          <text class="conv-house" wx:if="{{item.houseTitle}}">🏠 {{item.houseTitle}}</text>
        </view>
      </view>
    </scroll-view>
  </block>

  <!-- ===== 聊天界面（指定 conversationId 时展示） ===== -->
  <block wx:else>
    <!-- 房源标题条 -->
    <view class="house-bar" wx:if="{{houseTitle}}">
      <text class="house-bar-icon">🏠</text>
      <text class="house-bar-title">{{houseTitle}}</text>
    </view>

    <!-- 消息列表 -->
    <scroll-view class="msg-list" scroll-y scroll-with-animation>
      <view class="msg-empty" wx:if="{{messages.length === 0}}">
        <text class="empty-icon">💬</text>
        <text class="empty-text">暂无消息，发送第一条消息开始沟通吧～</text>
      </view>

      <view wx:for="{{messages}}" wx:key="id"
        class="msg-item {{item.isSelf ? 'mine' : 'other'}}">
        <image class="msg-avatar" src="{{item.isSelf ? currentUserAvatar : (peerInfo.avatar || '/assets/images/default-avatar.png')}}" mode="aspectFill"/>
        <view class="msg-bubble-wrap">
          <view class="msg-header">
            <text class="msg-name">{{item.isSelf ? '我' : (peerInfo.name || (item.role === 'landlord' ? '房东' : '租客'))}}</text>
            <text class="msg-role-tag" wx:if="!item.isSelf">{{item.role === 'landlord' ? '房东' : '租客'}}</text>
          </view>
          <view class="msg-bubble">
            <text class="msg-text">{{item.content}}</text>
            <!-- 消息状态 -->
            <view class="msg-status" wx:if="item.isSelf">
              <text wx:if="item.status === 'sending'" class="status-sending">发送中...</text>
              <text wx:elif="item.status === 'failed'" class="status-failed">发送失败</text>
              <text wx:else class="status-sent">已发送</text>
            </view>
          </view>
          <text class="msg-time">{{item.createTime}}</text>
        </view>
      </view>

      <!-- 底部占位 -->
      <view style="height:120rpx;"></view>
    </scroll-view>

    <!-- 输入框 -->
    <view class="input-bar safe-area-bottom">
      <input
        class="msg-input"
        value="{{inputText}}"
        bindinput="onInput"
        placeholder="输入消息..."
        confirm-type="send"
        bindconfirm="sendChatMessage"
        maxlength="500"
        adjust-position="{{true}}"
      />
      <view class="send-btn {{(sending || !inputText) ? 'disabled' : ''}}" bindtap="sendChatMessage">
        <text>发送</text>
      </view>
    </view>
  </block>

</view>
