/* pages/chat/chat.wxss */
.chat-page { display: flex; flex-direction: column; min-height: 100vh; background: #F5F5F5; }

/* ===== 会话列表 ===== */
.conv-loading { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 80rpx 0; }
.loading-dot { width: 40rpx; height: 40rpx; border-radius: 50%; background: #4A90E2; animation: pulse 1s infinite; }
.loading-text { color: #999; font-size: 26rpx; margin-top: 20rpx; }
@keyframes pulse { 0%,100%{opacity:1;} 50%{opacity:0.3;} }

.conv-empty { display: flex; flex-direction: column; align-items: center; padding: 120rpx 40rpx; }
.empty-icon { font-size: 100rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 30rpx; color: #666; margin-bottom: 16rpx; }
.empty-sub { font-size: 26rpx; color: #999; }

.conv-list { flex: 1; }
.conv-item { display: flex; align-items: center; padding: 28rpx 32rpx; background: #fff; border-bottom: 1rpx solid #F0F0F0; }
.conv-avatar { width: 96rpx; height: 96rpx; border-radius: 50%; flex-shrink: 0; background: #E8E8E8; }
.conv-info { flex: 1; margin-left: 24rpx; overflow: hidden; }
.conv-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.conv-name { font-size: 30rpx; font-weight: bold; color: #333; }
.conv-time { font-size: 22rpx; color: #999; }
.conv-bottom { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6rpx; }
.conv-last-msg { font-size: 26rpx; color: #999; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; }
.conv-badge { min-width: 36rpx; height: 36rpx; border-radius: 18rpx; background: #FF4444; color: #fff; font-size: 22rpx; display: flex; align-items: center; justify-content: center; padding: 0 8rpx; margin-left: 12rpx; }
.conv-house { font-size: 22rpx; color: #4A90E2; }

/* ===== 聊天界面 ===== */
.house-bar { display: flex; align-items: center; padding: 20rpx 32rpx; background: #EBF3FE; border-bottom: 1rpx solid #D0E4FA; }
.house-bar-icon { font-size: 28rpx; margin-right: 8rpx; }
.house-bar-title { font-size: 26rpx; color: #4A90E2; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.msg-list { flex: 1; padding: 20rpx 24rpx; box-sizing: border-box; }
.msg-empty { display: flex; flex-direction: column; align-items: center; padding: 100rpx 40rpx; }
.msg-empty .empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.msg-empty .empty-text { font-size: 28rpx; color: #999; text-align: center; }

/* 消息条目 */
.msg-item { display: flex; align-items: flex-end; margin-bottom: 28rpx; }
.msg-item.mine { flex-direction: row-reverse; }
.msg-avatar { width: 80rpx; height: 80rpx; border-radius: 50%; flex-shrink: 0; background: #E8E8E8; }
.msg-bubble-wrap { display: flex; flex-direction: column; max-width: 65%; margin: 0 16rpx; }
.msg-item.mine .msg-bubble-wrap { align-items: flex-end; }
.msg-item.other .msg-bubble-wrap { align-items: flex-start; }
.msg-header { display: flex; align-items: center; margin-bottom: 6rpx; }
.msg-name { font-size: 22rpx; color: #999; margin-right: 8rpx; }
.msg-role-tag { font-size: 18rpx; color: #4A90E2; background: #EBF3FE; padding: 2rpx 8rpx; border-radius: 10rpx; }
.msg-bubble { background: #fff; border-radius: 16rpx; padding: 20rpx 24rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.06); position: relative; }
.msg-item.mine .msg-bubble { background: #4A90E2; }
.msg-text { font-size: 28rpx; color: #333; line-height: 1.6; word-break: break-all; }
.msg-item.mine .msg-text { color: #fff; }
.msg-status { margin-top: 8rpx; font-size: 20rpx; }
.status-sending { color: #B0CAEE; }
.status-failed { color: #FF4444; }
.status-sent { color: #52C41A; }
.msg-time { font-size: 20rpx; color: #ccc; margin-top: 6rpx; }

/* 网络错误提示 */
.network-error { position: fixed; top: 100rpx; left: 50%; transform: translateX(-50%); background: rgba(0,0,0,0.7); color: #fff; padding: 16rpx 24rpx; border-radius: 8rpx; font-size: 26rpx; z-index: 9999; }

/* 加载更多 */
.loading-more { display: flex; align-items: center; justify-content: center; padding: 20rpx; font-size: 24rpx; color: #999; }
.loading-more::before { content: ''; width: 24rpx; height: 24rpx; border: 2rpx solid #999; border-top: 2rpx solid transparent; border-radius: 50%; margin-right: 12rpx; animation: spin 1s linear infinite; }
@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

/* 输入栏 */
.input-bar { position: fixed; bottom: 0; left: 0; right: 0; display: flex; align-items: center; padding: 20rpx 24rpx; background: #fff; border-top: 1rpx solid #EAEAEA; box-shadow: 0 -2rpx 8rpx rgba(0,0,0,.06); }
.safe-area-bottom { padding-bottom: calc(20rpx + constant(safe-area-inset-bottom)); padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); }
.msg-input { flex: 1; height: 72rpx; background: #F5F5F5; border-radius: 36rpx; padding: 0 28rpx; font-size: 28rpx; color: #333; }
.send-btn { min-width: 120rpx; height: 72rpx; background: #4A90E2; color: #fff; border-radius: 36rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; margin-left: 16rpx; flex-shrink: 0; }
.send-btn.disabled { background: #B0CAEE; }
