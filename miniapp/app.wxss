/**app.wxss**/
page {
  background-color: #F5F5F5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

/* 通用容器 */
.container {
  min-height: 100vh;
  box-sizing: border-box;
}

.page-container {
  padding: 20rpx;
  box-sizing: border-box;
}

/* 通用卡片 */
.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 通用按钮 */
.btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  box-sizing: border-box;
}

.btn-primary {
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  color: #FFFFFF;
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-secondary {
  background: #FFFFFF;
  color: #4A90E2;
  border: 2rpx solid #4A90E2;
}

.btn-secondary:active {
  background: #F0F7FF;
}

.btn-disabled {
  background: #CCCCCC !important;
  color: #FFFFFF !important;
  border: none !important;
}

.btn-small {
  width: auto;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  border-radius: 30rpx;
}

/* 通用输入框 */
.input-group {
  margin-bottom: 32rpx;
}

.input-label {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}

.input-required {
  color: #FF4444;
  margin-left: 4rpx;
}

.input-field {
  width: 100%;
  height: 88rpx;
  background: #F8F8F8;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.input-field:focus {
  background: #FFFFFF;
  border-color: #4A90E2;
}

.textarea-field {
  width: 100%;
  min-height: 200rpx;
  background: #F8F8F8;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.textarea-field:focus {
  background: #FFFFFF;
  border-color: #4A90E2;
}

/* 通用列表 */
.list-item {
  background: #FFFFFF;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.list-item:active {
  background: #F8F8F8;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 16rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: #CCCCCC;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #999999;
  margin-top: 24rpx;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: #EEEEEE;
  margin: 24rpx 0;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
}

.tag-primary {
  background: #E8F4FF;
  color: #4A90E2;
}

.tag-success {
  background: #E8F8F0;
  color: #52C41A;
}

.tag-warning {
  background: #FFF7E6;
  color: #FA8C16;
}

.tag-danger {
  background: #FFF1F0;
  color: #FF4444;
}

.tag-info {
  background: #F0F0F0;
  color: #666666;
}

/* 徽章 */
.badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  background: #FF4444;
  color: #FFFFFF;
  font-size: 20rpx;
  text-align: center;
  border-radius: 16rpx;
  border: 2rpx solid #FFFFFF;
}

/* 通用布局 */
.flex {
  display: flex;
}

.flex-row {
  flex-direction: row;
}

.flex-column {
  flex-direction: column;
}

.flex-center {
  align-items: center;
  justify-content: center;
}

.flex-between {
  justify-content: space-between;
}

.flex-align-center {
  align-items: center;
}

.flex-1 {
  flex: 1;
}

/* 通用间距 */
.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-30 { margin-top: 30rpx; }
.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-30 { margin-bottom: 30rpx; }
.ml-10 { margin-left: 10rpx; }
.ml-20 { margin-left: 20rpx; }
.mr-10 { margin-right: 10rpx; }
.mr-20 { margin-right: 20rpx; }

.pt-10 { padding-top: 10rpx; }
.pt-20 { padding-top: 20rpx; }
.pb-10 { padding-bottom: 10rpx; }
.pb-20 { padding-bottom: 20rpx; }
.pl-10 { padding-left: 10rpx; }
.pl-20 { padding-left: 20rpx; }
.pr-10 { padding-right: 10rpx; }
.pr-20 { padding-right: 20rpx; }

/* 通用文本 */
.text-center { text-align: center; }
.text-left { text-align: left; }
.text-right { text-align: right; }

.text-primary { color: #4A90E2; }
.text-success { color: #52C41A; }
.text-warning { color: #FA8C16; }
.text-danger { color: #FF4444; }
.text-info { color: #999999; }
.text-muted { color: #CCCCCC; }

.text-bold { font-weight: 500; }
.text-small { font-size: 24rpx; }
.text-large { font-size: 32rpx; }

/* 通用图片 */
.img-cover {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.img-contain {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

/* 通用圆角 */
.radius-small { border-radius: 8rpx; }
.radius-medium { border-radius: 12rpx; }
.radius-large { border-radius: 16rpx; }
.radius-circle { border-radius: 50%; }

/* 通用阴影 */
.shadow-small {
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.shadow-medium {
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.shadow-large {
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

/* 安全区域适配 */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
